# Assets/Sprites es carpeta generada desde art/ (NOVA_Arte_Tecnica.md, Reglas de trabajo)
/Assets/Sprites/
/Assets/Sprites.meta

*.claude

*entregables_uni

# Capturas de las pruebas a mano en Play: evidencia local, no se versiona
/mds/evidencias/

# Vistas en movimiento de art/_preview: salida derivada y pesada (tracking, desviacion 264)
art/_preview/**/*.gif

# Instrumentos de la musica (NOVA_Sonido.md, S.1.4): plugins VST3 portables y
# librerias de muestras. Se descargan con tools/instala_audio_libs.py, pesan
# cientos de MB y no se versionan.
/audio/_libs/
# Pistas renderizadas de la musica (nova_musica._cacheado): se regeneran solas
/audio/_cache/
# WAV de la musica: salida derivada y pesada (~90 MB por version). Se versionan
# el generador, el MIDI y el espectro; el WAV elegido entra en Assets/Audio/Music/
/audio/music/**/*.wav
# ...salvo los dos archivos del juego: la intro y el ciclo v3 -> v1 -> v2
# (NOVA_Sonido.md, S.5.2)
!/audio/music/main/ciclo/mus_main_intro.wav
!/audio/music/main/ciclo/mus_main_ciclo.wav
# T6-13 y T6-14: copia de audio/ que hace Nova → Audio → Importar audio (salida derivada, como Assets/Sprites/)
/Assets/Audio/Music/
/Assets/Audio/Music.meta
/Assets/Audio/SFX/
/Assets/Audio/SFX.meta
